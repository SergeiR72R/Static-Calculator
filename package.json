{
  "name": "balkenrechner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Online-Balkenrechner nach der Finite-Elemente-Methode (Durchlaufträger, Gelenke, Federn, Lastfallkombinationen, DXF-Export)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog": "node scripts/generate-catalog.mjs",
    "dxf:samples": "DXF_SAMPLES_DIR=dxf-samples vitest run src/export/dxf.test.ts && python3 scripts/dxf_audit.py dxf-samples"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "lz-string": "1.5",
    "radix-ui": "^1.7.0",
    "react": "19.2",
    "react-dom": "19.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "3.2"
  }
}
